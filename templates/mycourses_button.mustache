{{!
    @template local_playground/mycourses_button

    Renders a "Create Playground Course" button for the my/courses page.

    Example context (json):
    {
        "playgroundurl": "https://moodle.test/local/playground/index.php",
        "label": "Create my playground course"
    }
}}
<div class="local-playground-mycourses-button" style="display: inline-block; margin-left: 8px;">
    <form action="{{playgroundurl}}" method="get" class="d-inline">
        <button type="submit" class="btn btn-primary" style="margin: 4px 0;">
            <i class="fa fa-flask" aria-hidden="true"></i>
            {{label}}
        </button>
    </form>
</div>

